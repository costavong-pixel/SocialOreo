# =============================================================================
# SocialOreo environment template
# =============================================================================
#
# Setup locally only:
#   cp .env.example .env
#   fill in the values for your own development services
#   npx prisma migrate deploy
#   npm run dev
#
# Never commit .env. This file is the only env file tracked in git.
#
# Phase 1 required for a live audit:
#   DATABASE_URL
#   AUTH0_DOMAIN
#   AUTH0_CLIENT_ID
#   AUTH0_CLIENT_SECRET
#   AUTH0_SECRET
#   APP_BASE_URL
#   APIFY_API_TOKEN
#   APIFY_INSTAGRAM_ACTOR_ID
#   DEEPSEEK_API_KEY (primary AI) or OPENAI_API_KEY (backup)
#
# Phase 1 optional:
#   R2_* (report artifact storage — HTML export works without R2)
#   APIFY_TIKTOK_ACTOR_ID, DATA365_API_KEY, YOUTUBE_API_KEY (future platforms)
# =============================================================================

# ===== APP =====
NODE_ENV=development
PORT=3002
APP_URL=http://localhost:3002

# ===== DATABASE (required) =====
# Set DATABASE_URL to the connection string for your own local database.
# Example local URL (use your own local role and database):
# postgresql://localhost:5432/socialoreo?schema=public
DATABASE_URL=

# ===== AUTH0 AUTH (required) =====
# Use a Regular Web Application with localhost callback, logout, and origin
# URLs for local development. Do not copy production configuration here.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3002

# ===== STAGING ACCEPTANCE ONLY =====
# Disabled by default. The application additionally requires
# SOCIALOLLA_ENV=staging and the exact staging APP_BASE_URL before this can
# accept an Auth0 session whose provider email_verified claim is false.
SOCIALOLLA_STAGING_ACCEPTANCE_AUTH_BYPASS=false
SOCIALOLLA_STAGING_ACCEPTANCE_EMAILS=

# ===== META OWNER INSIGHTS (separate opt-in; never required for publishing or public audits) =====
# Register /api/meta/instagram/callback as the Meta app callback URL.
# Use a distinct 32-byte random value encoded with base64 for the encryption key.
SOCIALOLLA_INSTAGRAM_INSIGHTS_ENABLED=false
META_INSTAGRAM_CLIENT_ID=
META_INSTAGRAM_CLIENT_SECRET=
META_INSTAGRAM_TOKEN_ENCRYPTION_KEY=
META_INSTAGRAM_GRAPH_VERSION=v25.0

# ===== SQUARE PAYMENTS (sandbox only by default; server-side secrets only) =====
# SQUARE_ENV selects the Square environment: 'sandbox' or 'production'. Any other
# value fails closed (Square routes disabled). Production mode requires every
# required value below AND the API host for production (auto-selected from
# SQUARE_ENV via square-api.ts).
# The webhook notification URL must exactly match the URL set in the Square Developer Console.
# Catalog values below are item-variation IDs for one-time products. Monthly
# checkout uses the subscription plan ID; webhooks and ownership matching use
# its separate subscription plan variation ID.
SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=
SQUARE_EXPECTED_MERCHANT_ID=
# Required for hosted Monthly Sandbox checkout. Comma-separated owner test emails; normalized server-side and never sent to the browser.
SQUARE_SANDBOX_TESTER_EMAILS=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_CURRENCY=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
# Optional Square Payments API version (YYYY-MM-DD). Defaults to and must be at
# least 2026-07-15; below-floor or malformed values fail closed.
SQUARE_API_VERSION=2026-07-15
SQUARE_CATALOG_VARIATION_LIFETIME=
SQUARE_SUBSCRIPTION_PLAN_MONTHLY=
SQUARE_SUBSCRIPTION_PLAN_VARIATION_MONTHLY=
SQUARE_MONTHLY_PRICE_CENTS=
SQUARE_CATALOG_VARIATION_SINGLE_AUDIT=
SQUARE_CATALOG_VARIATION_CREATOR_PACK=
# Reviewed server-side money contracts for the Square catalog variations.
SQUARE_CATALOG_PRICE_SINGLE_AUDIT_CENTS=1100
SQUARE_CATALOG_PRICE_CREATOR_PACK_CENTS=9500

# ===== SOCIAL PROVIDERS =====
SOCIAL_PROVIDER_INSTAGRAM=apify
SOCIAL_PROVIDER_TIKTOK=apify
SOCIAL_PROVIDER_YOUTUBE=youtube
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=
# Admin-only Trend Radar pilot. Keep disabled until a bounded source test is approved.
TREND_DISCOVERY_ENABLED=false
APIFY_INSTAGRAM_TREND_ACTOR_ID=
# Optional second pass for spoken transcript extraction. This increases provider cost.
APIFY_INSTAGRAM_TRANSCRIPT_ACTOR_ID=
APIFY_TIKTOK_ACTOR_ID=
# Admin-only TikTok Trend Radar pilot. Keep disabled until a bounded source test is approved.
TIKTOK_TREND_DISCOVERY_ENABLED=false
DATA365_API_KEY=
# Admin-only YouTube Trend Radar pilot. Requires an enabled Google Cloud YouTube Data API key and available quota.
YOUTUBE_TREND_DISCOVERY_ENABLED=false
YOUTUBE_API_KEY=

# ===== AI ANALYSIS (required for audits) =====
AI_PROVIDER_PRIMARY=deepseek
AI_PROVIDER_BACKUP=openai
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ===== STORAGE (optional) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ===== SocialOlla staging Post integration =====
# A non-test runtime is unhealthy unless the real Content Factory is enabled
# and its durable POSTS_DB-backed /internal/v1 health reports data_reachable=true.
# The in-memory client is test-only and must never satisfy staging health.
CONTENT_FACTORY_ENABLED=true
CONTENT_FACTORY_API_URL=
CONTENT_FACTORY_API_SECRET=

# ===== SocialOlla Milestone 1 Watch configurable entitlements =====
# When true, the Watch competitor cap is read from the canonical entitlement
# snapshot (still bounded by the hard maximum). Default false preserves the
# existing plan-based behavior exactly.
SOCIALOLLA_WATCH_CONFIG_ENABLED=false

# ===== SocialOlla legacy Watch/beta boundaries =====
# Watch remains provider-disabled; the focused staging Post gate has its own
# explicit Instagram publishing flag below.
SOCIALOLLA_PROVIDER_DISABLED=true
# The staging Post gate changes this to false only after OAuth and the Meta
# test resource are approved. Production keeps the provider-disabled default.
SOCIALOLLA_INSTAGRAM_PUBLISH_ENABLED=false
SOCIALOLLA_ENV=staging
MEDIA_STORAGE_ROOT=
MEDIA_GRANT_SECRET=
META_INSTAGRAM_CLIENT_ID=
META_INSTAGRAM_CLIENT_SECRET=
META_INSTAGRAM_TOKEN_ENCRYPTION_KEY=
META_INSTAGRAM_GRAPH_VERSION=v25.0
# Canonical lifetime plan price (single pricing source; page + checkout read this):
SOCIALOLLA_LIFETIME_PRICE_CENTS=7900
# Legacy CreditAccount/CreditLedger writes are disabled by default. Set to
# "true" only to preserve the pre-M2 grant behavior during rollback:
SOCIALOLLA_LEGACY_CREDITS=false
