# =============================================================================
# SocialOreo environment template
# =============================================================================
#
# Setup locally only:
#   cp .env.example .env
#   fill in the values for your own development services
#   npx prisma migrate deploy
#   npm run dev
#
# Never commit .env. This file is the only env file tracked in git.
#
# Phase 1 required for a live audit:
#   DATABASE_URL
#   AUTH0_DOMAIN
#   AUTH0_CLIENT_ID
#   AUTH0_CLIENT_SECRET
#   AUTH0_SECRET
#   APP_BASE_URL
#   APIFY_API_TOKEN
#   APIFY_INSTAGRAM_ACTOR_ID
#   DEEPSEEK_API_KEY (primary AI) or OPENAI_API_KEY (backup)
#
# Phase 1 optional:
#   R2_* (report artifact storage — HTML export works without R2)
#   APIFY_TIKTOK_ACTOR_ID, DATA365_API_KEY, YOUTUBE_API_KEY (future platforms)
# =============================================================================

# ===== APP =====
NODE_ENV=development
PORT=3002
APP_URL=http://localhost:3002

# ===== DATABASE (required) =====
# Set DATABASE_URL to the connection string for your own local database.
# Example local URL (use your own local role and database):
# postgresql://localhost:5432/socialoreo?schema=public
DATABASE_URL=

# ===== AUTH0 AUTH (required) =====
# Use a Regular Web Application with localhost callback, logout, and origin
# URLs for local development. Do not copy production configuration here.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3002

# ===== META OWNER INSIGHTS (optional; never required for public audits) =====
# Register /api/meta/instagram/callback as the Meta app callback URL.
# Use a distinct 32-byte random value encoded with base64 for the encryption key.
META_INSTAGRAM_CLIENT_ID=
META_INSTAGRAM_CLIENT_SECRET=
META_INSTAGRAM_TOKEN_ENCRYPTION_KEY=
META_INSTAGRAM_GRAPH_VERSION=v25.0

# ===== SQUARE PAYMENTS (sandbox only; server-side secrets only) =====
# Keep SQUARE_ENV=sandbox. The application rejects any other value.
# The webhook notification URL must exactly match the URL set in the Square Developer Console.
# Catalog values below are item-variation IDs except the monthly subscription plan variation.
SQUARE_ENV=sandbox
# Required for hosted Monthly Sandbox checkout. Comma-separated owner test emails; normalized server-side and never sent to the browser.
SQUARE_SANDBOX_TESTER_EMAILS=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_CURRENCY=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_CATALOG_VARIATION_LIFETIME=
SQUARE_SUBSCRIPTION_PLAN_VARIATION_MONTHLY=
SQUARE_MONTHLY_PRICE_CENTS=
SQUARE_CATALOG_VARIATION_SINGLE_AUDIT=
SQUARE_CATALOG_VARIATION_CREATOR_PACK=

# ===== SOCIAL PROVIDERS =====
SOCIAL_PROVIDER_INSTAGRAM=apify
SOCIAL_PROVIDER_TIKTOK=apify
SOCIAL_PROVIDER_YOUTUBE=youtube
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=
# Admin-only Trend Radar pilot. Keep disabled until a bounded source test is approved.
TREND_DISCOVERY_ENABLED=false
APIFY_INSTAGRAM_TREND_ACTOR_ID=
# Optional second pass for spoken transcript extraction. This increases provider cost.
APIFY_INSTAGRAM_TRANSCRIPT_ACTOR_ID=
APIFY_TIKTOK_ACTOR_ID=
# Admin-only TikTok Trend Radar pilot. Keep disabled until a bounded source test is approved.
TIKTOK_TREND_DISCOVERY_ENABLED=false
DATA365_API_KEY=
# Admin-only YouTube Trend Radar pilot. Requires an enabled Google Cloud YouTube Data API key and available quota.
YOUTUBE_TREND_DISCOVERY_ENABLED=false
YOUTUBE_API_KEY=

# ===== AI ANALYSIS (required for audits) =====
AI_PROVIDER_PRIMARY=deepseek
AI_PROVIDER_BACKUP=openai
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ===== STORAGE (optional) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
