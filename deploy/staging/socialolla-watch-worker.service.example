[Unit]
Description=SocialOlla staging Watch capture worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/socialolla/staging

[Service]
Type=oneshot
User=socialolla
Group=socialolla
WorkingDirectory=/srv/socialolla/staging
EnvironmentFile=/srv/socialolla/config/socialolla-staging.env
Environment=NODE_ENV=staging
Environment=SOCIALOLLA_ENV=staging
Environment=SOCIALOLLA_PROVIDER_DISABLED=true
Environment=SOCIALOLLA_INSTAGRAM_PUBLISH_ENABLED=false
# Provider-disabled staging installation is an observable validation loop only.
# Deliberate dry-run keeps queued customer work and credits untouched.
ExecStart=/usr/bin/npm run watch-worker:once -- --dry-run
TimeoutStartSec=120
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
